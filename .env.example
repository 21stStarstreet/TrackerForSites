# TrackerForSites — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# PostgreSQL şifresi
DB_PASSWORD=postgres

# JWT imzalama anahtarı — EN AZ 32 KARAKTER, rastgele üret:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Dashboard'un production URL'i (API'nin CORS'unu açar)
DASHBOARD_ORIGIN=http://localhost

# tracker.js embed kodunda kullanılacak URL
TRACKER_URL=https://yourdomain.com/tracker.js
